{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfoljassistenten.local/schemas/evidence-record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "required": ["claim_id", "subject_id", "claim_type", "status", "evidence"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "claim_type": {
      "type": "string",
      "enum": [
        "platform_availability",
        "asset_allocation",
        "geographic_allocation",
        "fee",
        "risk",
        "performance",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["verified", "supported", "stale", "conflicted", "unverified"]
    },
    "as_of_date": {"type": ["string", "null"], "format": "date"},
    "value": {},
    "coverage_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "notes": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_role": {
            "type": "string",
            "enum": ["primary", "corroborating", "conflicting", "lead_only"]
          },
          "as_of_date": {"type": ["string", "null"], "format": "date"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
