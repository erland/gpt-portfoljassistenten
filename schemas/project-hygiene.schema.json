{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPT Project Hygiene Report",
  "type": "object",
  "required": [
    "schema_version",
    "result",
    "findings",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "result": {
      "enum": [
        "pass",
        "warning",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "classification",
          "path",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "CANONICAL",
              "RUNTIME",
              "DEVELOPMENT",
              "GENERATED",
              "TEMPORARY",
              "HISTORICAL"
            ]
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "recommendation": {
            "enum": [
              "keep",
              "remove",
              "review",
              "move",
              "regenerate"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}