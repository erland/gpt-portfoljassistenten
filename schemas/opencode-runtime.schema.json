{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Base Runtime Configuration",
  "type": "object",
  "required": [
    "enabled",
    "role",
    "mode",
    "layout",
    "validation"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "role": {
      "enum": [
        "primary",
        "secondary",
        "peer_distribution"
      ]
    },
    "mode": {
      "const": "opencode_workspace"
    },
    "layout": {
      "type": "object",
      "required": [
        "instructions",
        "runtime_contract",
        "knowledge",
        "config",
        "tools",
        "runtime_scripts"
      ],
      "properties": {
        "instructions": {
          "const": "AGENTS.md"
        },
        "runtime_contract": {
          "type": "string",
          "minLength": 1
        },
        "knowledge": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "const": "opencode.json"
        },
        "tools": {
          "type": "string",
          "minLength": 1
        },
        "runtime_scripts": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "require_agents_md",
        "require_runtime_contract"
      ],
      "properties": {
        "require_agents_md": {
          "type": "boolean"
        },
        "require_runtime_contract": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "required": [
        "enabled",
        "directory",
        "definitions"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "description",
              "references"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "directory": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
