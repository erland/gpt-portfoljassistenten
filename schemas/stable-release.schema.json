{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPT Stable Release Report",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "result",
    "stable",
    "gates",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "result": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "stable": {
      "type": "boolean",
      "const": true
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "blocked"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "file",
          "sha256"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}