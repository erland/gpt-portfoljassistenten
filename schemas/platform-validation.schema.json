{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom GPT Platform Validation Report",
  "type": "object",
  "required": [
    "schema_version",
    "result",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "result": {
      "enum": [
        "pass",
        "warning",
        "blocked"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "warning",
              "blocked",
              "skipped"
            ]
          },
          "actual": {},
          "limit": {},
          "message": {
            "type": "string"
          }
        }
      }
    },
    "release_allowed": {
      "type": "boolean"
    },
    "warnings_accepted": {
      "type": "boolean"
    }
  }
}